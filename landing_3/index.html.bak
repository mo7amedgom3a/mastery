          </div>
        </article>

        <article class="d-card" id="dip-3" data-reveal style="--d:160ms">
          <div class="d-card__top">
            <span class="tile tile--orange"><svg class="i"><use href="#i-grad-cap"/></svg></span>
            <span class="tag tag--orange">دبلوم</span>
          </div>
          <h3>دبلوم الرسم الاحترافي التدريبي</h3>
          <ul class="meta">
            <li><svg class="i i-xs"><use href="#i-book"/></svg> 10 دورات تدريبية</li>
            <li><svg class="i i-xs"><use href="#i-video"/></svg> جلسات مباشرة وتسجيلات</li>
            <li><svg class="i i-xs"><use href="#i-clock"/></svg> المدة: 3 أشهر</li>
            <li><svg class="i i-xs"><use href="#i-award"/></svg> شهادة معتمدة</li>
          </ul>
          <div class="p-foot">
            <span class="price" dir="ltr">$775</span>
            <button type="button" class="btn btn--secondary btn--sm add-cart" data-name="دبلوم الرسم الاحترافي التدريبي" data-price="775"><svg class="i i-xs"><use href="#i-plus"/></svg><span>أضف للسلة</span></button>
          </div>
        </article>
      </div>
