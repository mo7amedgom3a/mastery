<!-- ================= Header ================= -->
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#top">
      <span class="brand__mark"><svg class="i i-fill"><use href="#i-logo"/></svg></span>
      <span>ماستري أكاديمي</span>
    </a>
    <nav class="main-nav">
      <a href="#courses">جميع الأقسام</a>
      <button type="button" data-modal="corporate">طلبات الشركات</button>
      <button type="button" data-modal="affiliate">التسويق بالعمولة</button>
      <a href="#verify">التحقق من الشهادة</a>
      <button type="button" data-modal="instructor">انضم لنا كمدرب</button>
    </nav>
    <div class="header-actions">
      <button type="button" class="header-search" id="searchTrigger" aria-label="بحث سريع">
        <svg class="i i-sm"><use href="#i-search"/></svg>
        <span>ابحث…</span>
        <kbd id="kbdHint">Ctrl K</kbd>
      </button>
      <button type="button" class="icon-btn" id="themeToggle" aria-label="تبديل المظهر">
        <svg class="i i-moon"><use href="#i-moon"/></svg>
        <svg class="i i-sun"><use href="#i-sun"/></svg>
      </button>
      <button type="button" class="icon-btn cart-btn" id="cartToggle" aria-label="سلة المشتريات">
        <svg class="i"><use href="#i-cart"/></svg>
        <span class="cart-count" id="cartCount" hidden>0</span>
      </button>
      <button type="button" class="btn btn--secondary btn--sm login-desktop" data-modal="login">تسجيل الدخول</button>
      <a class="btn btn--primary btn--sm hero-subscribe" href="#courses">اشترك الآن</a>
      <button type="button" class="icon-btn menu-btn" id="menuBtn" aria-label="القائمة">
        <svg class="i"><use href="#i-menu"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="scrim" id="scrim"></div>

<!-- Mobile navigation drawer -->
<aside class="drawer drawer--start" id="navDrawer" aria-label="قائمة التنقل">
