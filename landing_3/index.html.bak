            <li><svg class="i i-xs"><use href="#i-award"/></svg> شهادة معتمدة</li>
          </ul>
          <div class="p-foot">
            <span class="price" dir="ltr">$775</span>
            <button type="button" class="btn btn--secondary btn--sm add-cart" data-name="دبلوم التسويق الاحترافي التدريبي" data-price="775"><svg class="i i-xs"><use href="#i-plus"/></svg><span>أضف للسلة</span></button>
          </div>
        </article>

        <article class="d-card" id="dip-2" data-reveal style="--d:80ms">
          <div class="d-card__top">
            <span class="tile tile--blue"><svg class="i"><use href="#i-chart"/></svg></span>
            <span class="tag tag--pink">الدفعة السادسة</span>
          </div>
          <h3>إتقان المبيعات — الدفعة السادسة</h3>
          <ul class="meta">
