  <symbol id="i-infinity" viewBox="0 0 24 24"><path d="M12 12c-1.9-2.4-3.6-3.8-5.6-3.8a3.8 3.8 0 1 0 0 7.6c2 0 3.7-1.4 5.6-3.8Zm0 0c1.9 2.4 3.6 3.8 5.6 3.8a3.8 3.8 0 1 0 0-7.6c-2 0-3.7 1.4-5.6 3.8Z"/></symbol>
  <symbol id="i-video" viewBox="0 0 24 24"><rect x="2.5" y="6" width="13" height="12" rx="2.5"/><path d="m15.5 10.5 6-3.5v10l-6-3.5"/></symbol>
  <symbol id="i-message" viewBox="0 0 24 24"><path d="M12 21a9 9 0 1 0-8.6-6.3L2.5 21l6.3-1.4A9 9 0 0 0 12 21Z"/></symbol>
