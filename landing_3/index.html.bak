      </div>
      <div class="d-grid">
        <article class="d-card" id="dip-1" data-reveal>
          <div class="d-card__top">
            <span class="tile tile--purple"><svg class="i"><use href="#i-grad-cap"/></svg></span>
            <span class="tag tag--purple">دبلوم</span>
          </div>
          <h3>دبلوم التسويق الاحترافي التدريبي</h3>
          <ul class="meta">
            <li><svg class="i i-xs"><use href="#i-book"/></svg> 12 دورة تدريبية</li>
            <li><svg class="i i-xs"><use href="#i-video"/></svg> بث مباشر تفاعلي</li>
