    <div class="cart-total"><span>الإجمالي</span><span dir="ltr" id="cartTotal">$0</span></div>
    <button type="button" class="btn btn--primary btn--block" id="checkoutBtn" disabled>إتمام الشراء</button>
  </div>
</aside>

<main id="top">

  <!-- ================= Hero ================= -->
  <section class="hero container">
    <nav class="crumbs" aria-label="مسار الصفحة">
      <a href="#top">الرئيسية</a>
      <svg class="i"><use href="#i-chev-left"/></svg>
      <span class="cur">ماستري أكاديمي</span>
    </nav>

    <div class="hero-label" data-reveal><span class="dot"></span> منصة التعلم الرائدة في الوطن العربي</div>
    <h1 class="hero-title" data-reveal style="--d:60ms">ماستري أكاديمي</h1>
    <p class="hero-sub" data-reveal style="--d:120ms">تعلم ما يغير عالمك.</p>
    <div class="hero-meta" data-reveal style="--d:180ms">
      <span><svg class="i i-sm"><use href="#i-user"/></svg> فريق ماستري أكاديمي</span>
      <span><svg class="i i-sm"><use href="#i-clock"/></svg> يُحدَّث المحتوى باستمرار</span>
    </div>

    <div class="hero-actions" data-reveal style="--d:240ms">
      <a class="btn btn--primary btn--lg" href="#courses">اشترك الآن</a>
      <button type="button" class="btn btn--secondary btn--lg" data-modal="login">سجل دخول الآن</button>
    </div>

    <div class="hero-metrics" id="metrics" data-reveal style="--d:300ms">
      <div class="metric">
        <svg class="i"><use href="#i-users"/></svg>
        <div><strong dir="ltr" data-count="12000" data-prefix="+">+12,000</strong><small>متدرب ومتدربة</small></div>
      </div>
      <div class="metric">
        <svg class="i"><use href="#i-book-open"/></svg>
        <div><strong dir="ltr" data-count="50" data-prefix="+">+50</strong><small>دورة تدريبية</small></div>
      </div>
      <div class="metric">
        <svg class="i"><use href="#i-award"/></svg>
        <div><strong>معتمدة دولياً</strong><small>شهادات بعد كل برنامج</small></div>
      </div>
    </div>
  </section>

  <!-- ================= Courses (Notion-style database) ================= -->
  <section class="section" id="courses">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="kicker"><svg class="i"><use href="#i-book-open"/></svg> الدورات</span>
          <h2>تصفح الدورات التالية</h2>
          <p class="section-desc">دورات قصيرة ومركّزة يقدمها خبراء معتمدون — اختر قسمك وابدأ من حيث يناسبك.</p>
        </div>
        <div class="db-controls">
          <div class="chips" id="catChips">
            <button type="button" class="chip chip--on" data-cat="all">الكل</button>
            <button type="button" class="chip" data-cat="law">قانون</button>
            <button type="button" class="chip" data-cat="mgmt">إدارة</button>
            <button type="button" class="chip" data-cat="mkt">تسويق</button>
            <button type="button" class="chip" data-cat="fin">مالية</button>
          </div>
          <div class="seg" id="viewSeg" role="group" aria-label="طريقة العرض">
            <button type="button" data-view="grid" class="active" aria-label="عرض البطاقات"><svg class="i i-sm"><use href="#i-grid"/></svg></button>
            <button type="button" data-view="table" aria-label="عرض الجدول"><svg class="i i-sm"><use href="#i-list"/></svg></button>
          </div>
        </div>
      </div>

      <div id="courseGrid" class="course-grid"></div>
      <div id="courseTable" class="course-table" hidden>
        <table>
          <thead><tr><th>الدورة</th><th>التصنيف</th><th>المدرب</th><th>السعر</th><th></th></tr></thead>
          <tbody id="courseTableBody"></tbody>
        </table>
      </div>

      <div class="section-more">
        <button type="button" class="btn btn--secondary" id="loadMore">تصفح المزيد <svg class="i i-sm"><use href="#i-arrow-left"/></svg></button>
        <span class="all-shown" id="allShown" hidden>تم عرض جميع الدورات المتاحة حالياً</span>
      </div>
    </div>
  </section>

  <!-- ================= Diplomas ================= -->
  <section class="section" id="diplomas">
    <div class="container">
      <div class="section-head">
        <span class="kicker"><svg class="i"><use href="#i-grad-cap"/></svg> الدبلومات</span>
        <h2>تصفح الدبلومات التالية</h2>
