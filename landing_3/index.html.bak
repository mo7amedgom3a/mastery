  <!-- ================= Features ================= -->
  <section class="section section--rule" id="features">
    <div class="container features-grid">
      <div class="features-intro" data-reveal>
        <span class="kicker"><svg class="i"><use href="#i-award"/></svg> تجربة ماستري</span>
        <h2>تمتع بتجربة تعليمية فريدة</h2>
        <p class="section-desc">صممنا كل التفاصيل لتكون رحلة تعلّم مرنة وموثوقة وقريبة منك — من أول درس حتى الشهادة.</p>
        <a class="btn btn--primary" href="#courses">اشترك الآن</a>
      </div>
      <ul class="feature-list">
        <li data-reveal><span class="f-num">01</span><span class="tile tile--blue"><svg class="i"><use href="#i-monitor"/></svg></span><p>تابع جميع الدورات من أي جهاز، أينما كنت ووقتما تريد</p></li>
        <li data-reveal style="--d:60ms"><span class="f-num">02</span><span class="tile tile--green"><svg class="i"><use href="#i-award"/></svg></span><p>احصل على شهادة معتمدة من ماستري بعد إتمام أي دورة</p></li>
        <li data-reveal style="--d:120ms"><span class="f-num">03</span><span class="tile tile--purple"><svg class="i"><use href="#i-infinity"/></svg></span><p>شاهد دوراتك مرات غير محدودة لمدة عام كامل</p></li>
        <li data-reveal style="--d:180ms"><span class="f-num">04</span><span class="tile tile--orange"><svg class="i"><use href="#i-video"/></svg></span><p>تعلم مع دبلومات بث مباشر تفاعلية</p></li>
        <li data-reveal style="--d:240ms"><span class="f-num">05</span><span class="tile tile--pink"><svg class="i"><use href="#i-message"/></svg></span><p>اطرح أسئلتك واستفد من خبرة المدربين</p></li>
        <li data-reveal style="--d:300ms"><span class="f-num">06</span><span class="tile tile--yellow"><svg class="i"><use href="#i-headset"/></svg></span><p>تمتع بخدمة عملاء فائقة التميز</p></li>
      </ul>
    </div>
  </section>

  <!-- ================= Testimonials ================= -->
  <section class="section section--rule" id="testimonials">
    <div class="container container--narrow">
      <div class="section-head">
        <span class="kicker"><svg class="i"><use href="#i-message"/></svg> آراء المتدربين</span>
        <h2>ماذا قال المتدربون عن ماستري أكاديمي</h2>
      </div>
      <div class="quotes">
        <figure class="quote" data-reveal>
          <div class="stars" aria-label="تقييم 5 من 5">
            <svg class="i i-fill"><use href="#i-star"/></svg><svg class="i i-fill"><use href="#i-star"/></svg><svg class="i i-fill"><use href="#i-star"/></svg><svg class="i i-fill"><use href="#i-star"/></svg><svg class="i i-fill"><use href="#i-star"/></svg>
          </div>
          <blockquote>«ماستري أكاديمي غيرت طريقة تفكيري في التسويق، الدورات احترافية جداً.»</blockquote>
          <figcaption>
            <span class="avatar avatar--blue">أ</span>
            <div><strong>أحمد م.</strong><span>مدير تسويق</span></div>
          </figcaption>
        </figure>
        <figure class="quote quote--offset" data-reveal style="--d:120ms">
          <div class="stars" aria-label="تقييم 5 من 5">
            <svg class="i i-fill"><use href="#i-star"/></svg><svg class="i i-fill"><use href="#i-star"/></svg><svg class="i i-fill"><use href="#i-star"/></svg><svg class="i i-fill"><use href="#i-star"/></svg><svg class="i i-fill"><use href="#i-star"/></svg>
          </div>
          <blockquote>«حصلت على شهادة معتمدة وزاد راتبي 30% خلال 3 أشهر!»</blockquote>
          <figcaption>
            <span class="avatar avatar--pink">س</span>
            <div><strong>سارة ع.</strong><span>متخصصة مبيعات</span></div>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ================= Certificate verification ================= -->
  <section class="section section--rule" id="verify">
    <div class="container container--narrow">
      <div class="section-head" data-reveal>
        <span class="kicker"><svg class="i"><use href="#i-shield"/></svg> الموثوقية</span>
        <h2>التحقق من الشهادة</h2>
        <p class="section-desc">أدخل رقم الشهادة المطبوع أسفل شهادتك للتأكد من صحتها وسريانها.</p>
      </div>
      <form class="verify-form" id="verifyForm" data-reveal novalidate>
        <input type="text" id="certInput" dir="ltr" placeholder="MA-2025-4821" aria-label="رقم الشهادة">
        <button type="submit" class="btn btn--primary">تحقق من الشهادة</button>
      </form>
      <p class="verify-hint" data-reveal>للتجربة، جرّب أحد الأرقام التوضيحية: <code dir="ltr">MA-2025-4821</code> أو <code dir="ltr">MA-2024-1173</code></p>
      <div id="verifyResult" aria-live="polite"></div>
    </div>
  </section>

  <!-- ================= Instructor callout ================= -->
  <section class="section">
    <div class="container">
      <div class="callout" data-reveal>
        <span class="callout__icon"><svg class="i"><use href="#i-mic"/></svg></span>
        <div class="callout__body">
          <h3>مدرب خبير؟ إذاً انضم لنا</h3>
          <p>كن أحد الخبراء في ماستري أكاديمي — انشر دوراتك واوصل إلى أكثر من 12,000 متدرب في الوطن العربي.</p>
        </div>
        <button type="button" class="btn btn--primary" data-modal="instructor">انضم إلينا الآن</button>
      </div>
    </div>
  </section>

  <!-- ================= FAQ (Notion toggle blocks) ================= -->
  <section class="section section--rule" id="faq">
    <div class="container container--narrow">
      <div class="section-head">
        <span class="kicker"><svg class="i"><use href="#i-message"/></svg> الأسئلة الشائعة</span>
        <h2>الأسئلة الشائعة</h2>
        <p class="section-desc">كل ما تحتاج معرفته عن الحساب، الدفع والسياسات.</p>
      </div>
      <div id="faqList" data-reveal>
        <div class="faq">
          <button type="button" class="faq__q" aria-expanded="false"><svg class="i i-sm chev"><use href="#i-chev-down"/></svg> كيف أصل إلى حسابي وكلمة المرور؟</button>
          <div class="faq__a"><div class="faq__a-in"><p>بعد الاشتراك تصلك رسالة على بريدك لتفعيل حسابك وإنشاء كلمة مرور. يمكنك في أي وقت إعادة تعيين كلمة المرور من صفحة تسجيل الدخول، وستصلك رسالة برابط آمن لإتمام ذلك.</p></div></div>
        </div>
        <div class="faq">
          <button type="button" class="faq__q" aria-expanded="false"><svg class="i i-sm chev"><use href="#i-chev-down"/></svg> كيف تحمون معلوماتي الشخصية؟</button>
          <div class="faq__a"><div class="faq__a-in"><p>نستخدم تشفير SSL في كامل الموقع، ولا نشارك بياناتك مع أي طرف ثالث. تُعالَج المدفوعات بالكامل عبر بوابات دفع آمنة ومعتمدة ولا نخزّن بيانات بطاقتك على أنظمتنا.</p></div></div>
        </div>
        <div class="faq">
          <button type="button" class="faq__q" aria-expanded="false"><svg class="i i-sm chev"><use href="#i-chev-down"/></svg> ما سياسة الشراء والدفع؟</button>
          <div class="faq__a"><div class="faq__a-in"><p>يمكنك الدفع ببطاقات Visa وMastercard أو عبر Apple Pay. يُفعَّل وصولك الكامل للدورة فور اكتمال عملية الدفع، ويصلك تأكيد بالبريد الإلكتروني مع فاتورة الشراء.</p></div></div>
        </div>
        <div class="faq">
          <button type="button" class="faq__q" aria-expanded="false"><svg class="i i-sm chev"><use href="#i-chev-down"/></svg> ما سياسة استخدام الدورات التدريبية بالموقع؟</button>
          <div class="faq__a"><div class="faq__a-in"><p>لك وصول كامل ومشاهدات غير محدودة لمدة عام كامل من تاريخ الشراء. المحتوى مخصص للاستخدام الشخصي فقط ولا يجوز تنزيله أو إعادة نشره أو مشاركته مع الآخرين.</p></div></div>
        </div>
        <div class="faq">
          <button type="button" class="faq__q" aria-expanded="false"><svg class="i i-sm chev"><use href="#i-chev-down"/></svg> ما شروط الاستخدام لكل دورة؟</button>
          <div class="faq__a"><div class="faq__a-in"><p>لكل دورة شروط استخدام خاصة توضحها صفحتها، مثل المتطلبات المسبقة ومدة الوصول ونمط التدريب. ننصح بمراجعتها جيداً قبل إتمام عملية الشراء.</p></div></div>
        </div>
        <div class="faq">
          <button type="button" class="faq__q" aria-expanded="false"><svg class="i i-sm chev"><use href="#i-chev-down"/></svg> ما سياسة الاسترداد / الاسترجاع؟</button>
          <div class="faq__a"><div class="faq__a-in"><p>يمكنك طلب استرداد كامل للمبلغ خلال 14 يوماً من تاريخ الشراء، بشرط ألا تكون شاهدت أكثر من 20% من محتوى الدورة. يُعاد المبلغ إلى وسيلة الدفع نفسها خلال 5 إلى 7 أيام عمل.</p></div></div>
        </div>
        <div class="faq">
          <button type="button" class="faq__q" aria-expanded="false"><svg class="i i-sm chev"><use href="#i-chev-down"/></svg> هل يمكنني الحصول على اعتماد دولي عند إتمام البرنامج؟</button>
          <div class="faq__a"><div class="faq__a-in"><p>نعم، تحصل بعد إتمام أي دورة أو دبلوم على شهادة معتمدة من ماستري أكاديمي، ويمكن التحقق من صحتها إلكترونياً في أي وقت عبر صفحة «التحقق من الشهادة».</p></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= Footer ================= -->
  <footer class="site-footer" id="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <span class="brand"><span class="brand__mark"><svg class="i i-fill"><use href="#i-logo"/></svg></span> ماستري أكاديمي</span>
          <p>منصة عربية للتعلم الاحترافي — دورات ودبلومات وباقات في الأعمال، التسويق، القانون، الإدارة والمالية.</p>
          <div class="store-badges">
            <a class="store-badge" href="https://play.google.com/store" target="_blank" rel="noopener">
              <svg class="i i-fill" width="20" height="20"><use href="#i-gplay"/></svg>
              <span><small>حمّله من</small><strong>Google Play</strong></span>
            </a>
            <a class="store-badge" href="https://apps.apple.com" target="_blank" rel="noopener">
              <svg class="i i-fill" width="20" height="20"><use href="#i-apple"/></svg>
              <span><small>حمّله من</small><strong>App Store</strong></span>
            </a>
          </div>
        </div>

        <div>
          <h4>روابط سريعة</h4>
          <nav>
            <a href="#top">حول ماستري أكاديمي</a>
            <button type="button" data-modal="contact">تواصل معنا</button>
            <button type="button" data-modal="instructor">انضم لنا كمدرب</button>
            <button type="button" data-modal="consult">استشارات</button>
            <a href="#verify">تحقق من الشهادة</a>
          </nav>
        </div>

        <div>
          <h4>السياسات</h4>
          <nav>
            <button type="button" data-modal="news">النشرة البريدية</button>
            <button type="button" id="footerCart">سلة المشتريات</button>
            <button type="button" data-faq="1">سياسة الخصوصية</button>
            <button type="button" data-faq="4">شروط الاستخدام</button>
          </nav>
        </div>

        <div>
          <h4>تابعنا على</h4>
          <div class="social-row">
            <a class="icon-btn" href="https://instagram.com" target="_blank" rel="noopener" aria-label="انستغرام"><svg class="i i-sm"><use href="#i-instagram"/></svg></a>
            <a class="icon-btn" href="https://linkedin.com" target="_blank" rel="noopener" aria-label="لينكدإن"><svg class="i i-sm"><use href="#i-linkedin"/></svg></a>
            <a class="icon-btn" href="https://x.com" target="_blank" rel="noopener" aria-label="إكس"><svg class="i i-sm i-fill"><use href="#i-xlogo"/></svg></a>
            <a class="icon-btn" href="https://facebook.com" target="_blank" rel="noopener" aria-label="فيسبوك"><svg class="i i-sm"><use href="#i-facebook"/></svg></a>
            <a class="icon-btn" href="https://youtube.com" target="_blank" rel="noopener" aria-label="يوتيوب"><svg class="i i-sm"><use href="#i-youtube"/></svg></a>
          </div>
        </div>
      </div>

      <div class="footer-pay">
        <div class="pay-chips">
          <span class="pay-chip" style="letter-spacing:.08em">VISA</span>
          <span class="pay-chip">
            <svg width="26" height="16" viewBox="0 0 36 22" aria-hidden="true"><circle cx="13" cy="11" r="9" fill="#EB001B"/><circle cx="23" cy="11" r="9" fill="#F79E1B" fill-opacity=".9"/></svg>
            Mastercard
          </span>
          <span class="pay-chip"><svg class="i i-xs i-fill"><use href="#i-apple"/></svg> Apple Pay</span>
        </div>
        <span class="ssl-note"><svg class="i i-sm"><use href="#i-lock"/></svg> بوابات دفع آمنة ومعتمدة، مشفّرة عبر SSL</span>
      </div>

      <div class="footer-bottom">
        <span>جميع الحقوق محفوظة</span>
        <span dir="ltr">© 2025 Sahel Reach FZE — emasteryacademy.com</span>
      </div>
    </div>
  </footer>
</main>

<!-- ================= Modal ================= -->
<div class="modal-wrap" id="modalWrap">
  <div class="modal" role="dialog" aria-modal="true">
    <button type="button" class="icon-btn modal__close" data-close aria-label="إغلاق"><svg class="i"><use href="#i-close"/></svg></button>
    <div id="modalBody"></div>
  </div>
</div>

<!-- ================= Command palette ================= -->
<div class="palette-wrap" id="paletteWrap">
  <div class="palette" role="dialog" aria-modal="true" aria-label="البحث السريع">
    <div class="palette__head">
      <svg class="i"><use href="#i-search"/></svg>
      <input type="text" id="paletteInput" placeholder="ابحث عن دورة، دبلوم، باقة أو قسم…" autocomplete="off">
      <kbd>Esc</kbd>
    </div>
    <div class="palette__results" id="paletteResults"></div>
    <div class="pal-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> تنقّل</span>
      <span><kbd>↵</kbd> فتح</span>
      <span><kbd>Esc</kbd> إغلاق</span>
    </div>
  </div>
</div>

<script>
(() => {
'use strict';
const $  = (s, c=document) => c.querySelector(s);
const $$ = (s, c=document) => [...c.querySelectorAll(s)];
const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ---------------- Data ---------------- */
const CATS = {
  law:{label:'قانون', icon:'scale',     cls:'orange'},
  mgmt:{label:'إدارة', icon:'target',   cls:'purple'},
  mkt:{label:'تسويق', icon:'chart',     cls:'blue'},
  fin:{label:'مالية', icon:'banknote',  cls:'green'},
};
const COURSES = [
  {id:'c1', title:'تطبيقات قانون العمل', instructor:'أ. نايف', price:0, cat:'law', lessons:10, hours:'ساعتان'},
  {id:'c2', title:'الإدارة بالأهداف والنتائج OKR\u2019s', instructor:'د. شاهر شهدي', price:129, cat:'mgmt', lessons:14, hours:'4 ساعات'},
  {id:'c3', title:'التسويق المصرفي', instructor:'أ. سهيل الحمدني', price:129, cat:'mkt', lessons:12, hours:'3 ساعات'},
  {id:'c4', title:'النظام السعودي', instructor:'قريباً', price:129, cat:'law', lessons:16, hours:'5 ساعات', soon:true},
  {id:'c5', title:'مهارات القيادة الحديثة', instructor:'د. شاهر شهدي', price:99, cat:'mgmt', lessons:11, hours:'3 ساعات'},
  {id:'c6', title:'التسويق بالمحتوى', instructor:'أ. سهيل الحمدني', price:79, cat:'mkt', lessons:9, hours:'ساعتان ونصف'},
  {id:'c7', title:'إدارة المشاريع الاحترافية PMP', instructor:'د. شاهر شهدي', price:149, cat:'mgmt', lessons:20, hours:'6 ساعات', extra:true},
  {id:'c8', title:'التحليل المالي للشركات', instructor:'د. هبة الحمادي', price:139, cat:'fin', lessons:15, hours:'4 ساعات ونصف', extra:true},
  {id:'c9', title:'إعلانات ميتا من الصفر', instructor:'أ. سهيل الحمدني', price:89, cat:'mkt', lessons:13, hours:'3 ساعات', extra:true},
];
const CERTS = {
  'MA-2025-4821':{name:'أحمد م.', program:'دبلوم التسويق الاحترافي التدريبي', date:'مارس 2025'},
  'MA-2024-1173':{name:'سارة ع.', program:'إتقان المبيعات — الدفعة السادسة', date:'نوفمبر 2024'},
};

/* ---------------- Theme ---------------- */
const root = document.documentElement;
const loadPref = () => { try { return localStorage.getItem('ma-theme'); } catch(e){ return null; } };
const savePref = v  => { try { localStorage.setItem('ma-theme', v); } catch(e){} };
root.dataset.theme = loadPref() || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
function toggleTheme(){ root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark'; savePref(root.dataset.theme); }
 $('#themeToggle').addEventListener('click', toggleTheme);
if (navigator.platform.toLowerCase().includes('mac')) $('#kbdHint').textContent = '\u2318K';

/* ---------------- Toasts ---------------- */
function toast(msg, icon='check'){
  const el = document.createElement('div');
  el.className = 'toast';
  el.innerHTML = `<svg class="i"><use href="#i-${icon}"/></svg><span>${msg}</span>`;
  $('#toasts').appendChild(el);
  requestAnimationFrame(() => el.classList.add('show'));
  setTimeout(() => { el.classList.remove('show'); setTimeout(() => el.remove(), 350); }, 2600);
}

/* ---------------- Layers (drawer / modal / palette) ---------------- */
const scrim = $('#scrim'), navDrawer = $('#navDrawer'), cartDrawer = $('#cartDrawer');
const modalWrap = $('#modalWrap'), modalBody = $('#modalBody');
const paletteWrap = $('#paletteWrap'), paletteInput = $('#paletteInput'), paletteResults = $('#paletteResults');
const lock = on => document.body.classList.toggle('locked', on);

function closeAllLayers(){
  navDrawer.classList.remove('open');
  cartDrawer.classList.remove('open');
  modalWrap.classList.remove('show');
  paletteWrap.classList.remove('show');
  scrim.classList.remove('show');
  lock(false);
}
scrim.addEventListener('click', closeAllLayers);
modalWrap.addEventListener('click', e => { if (e.target === modalWrap) closeAllLayers(); });
paletteWrap.addEventListener('click', e => { if (e.target === paletteWrap) closeAllLayers(); });

/* ---------------- Cart ---------------- */
const cart = new Map();
const LBL_ADD  = '<svg class="i i-xs"><use href="#i-plus"/></svg><span>أضف للسلة</span>';
const LBL_ADDED= '<svg class="i i-xs"><use href="#i-check"/></svg><span>في السلة</span>';

function renderCart(){
  const items = [...cart.values()], n = items.length;
  const badge = $('#cartCount');
  badge.textContent = n; badge.hidden = !n;
  if (n){ badge.classList.remove('pop'); void badge.offsetWidth; badge.classList.add('pop'); }
  $('#cartTitle').textContent = n ? `سلة المشتريات (${n})` : 'سلة المشتريات';

  $('#cartItems').innerHTML = n
    ? items.map(i => `
        <div class="cart-row">
          <div><strong>${i.name}</strong><span class="cart-row__price">${i.price ? `<span dir="ltr">$${i.price}</span>` : 'مجاني'}</span></div>
          <button type="button" class="icon-btn icon-btn--xs cart-rm" data-name="${i.name}" aria-label="إزالة من السلة"><svg class="i i-xs"><use href="#i-close"/></svg></button>
        </div>`).join('')
    : `<div class="cart-empty">
         <svg class="i i-lg"><use href="#i-cart"/></svg>
         <p>سلتك فارغة</p>
         <span>تصفح الدورات والدبلومات وأضف ما يناسبك.</span>
         <button type="button" class="btn btn--secondary btn--sm" data-close data-scroll="#courses">تصفح الدورات</button>
       </div>`;

  const total = items.reduce((s,i) => s + i.price, 0);
  $('#cartTotal').textContent = '$' + total;
  $('#checkoutBtn').disabled = !n;
  $$('.add-cart').forEach(b => {
    const on = cart.has(b.dataset.name);
    b.classList.toggle('added', on);
    b.innerHTML = on ? LBL_ADDED : LBL_ADD;
  });
}

/* Global add-to-cart delegation (courses, diplomas, bundles) */
document.addEventListener('click', e => {
  const btn = e.target.closest('.add-cart');
  if (!btn) return;
  const { name, price } = btn.dataset;
  if (cart.has(name)) {
    cart.delete(name);
    toast('تمت الإزالة من السلة', 'close');
  } else {
    cart.set(name, { name, price: +price || 0 });
    toast(`أُضيف «${name}» إلى السلة`);
  }
  renderCart();
});
 $('#cartItems').addEventListener('click', e => {
  const rm = e.target.closest('.cart-rm');
  if (!rm) return;
  cart.delete(rm.dataset.name);
  toast('تمت الإزالة من السلة', 'close');
  renderCart();
});
function openCart(){ closeAllLayers(); renderCart(); cartDrawer.classList.add('open'); scrim.classList.add('show'); lock(true); }
 $('#cartToggle').addEventListener('click', openCart);
 $('#footerCart').addEventListener('click', openCart);
 $('#checkoutBtn').addEventListener('click', () => {
  if (!cart.size) return;
  toast('جارٍ تحويلك إلى بوابة الدفع الآمنة…', 'lock');
});

/* ---------------- Courses: render / filter / views ---------------- */
const state = { cat:'all', view:'grid', expanded:false };
const lessonWord = n => n > 10 ? 'درساً' : 'دروس';
const priceHtml  = c => c.price === 0 ? '<span class="price price--free">مجاني</span>' : `<span class="price" dir="ltr">$${c.price}</span>`;
const addBtnHtml = c => c.soon
  ? '<button type="button" class="btn btn--secondary btn--sm" disabled>قريباً</button>'
  : `<button type="button" class="btn btn--secondary btn--sm add-cart" data-name="${c.title}" data-price="${c.price}">${LBL_ADD}</button>`;

function cardHtml(c, i){
  const cat = CATS[c.cat];
  return `
  <article class="p-card" data-id="${c.id}" style="animation-delay:${Math.min(i*45,400)}ms">
    <div class="p-card__head">
      <span class="tile tile--${cat.cls}"><svg class="i"><use href="#i-${cat.icon}"/></svg></span>
      <div class="p-card__tags">
        <span class="tag tag--${cat.cls}">${cat.label}</span>
        ${c.soon ? '<span class="tag tag--yellow">قريباً</span>' : ''}
      </div>
    </div>
    <h3 class="p-card__title">${c.title}</h3>
    <ul class="meta">
      <li><svg class="i i-xs"><use href="#i-user"/></svg> ${c.instructor}</li>
      <li><svg class="i i-xs"><use href="#i-play"/></svg> ${c.lessons} ${lessonWord(c.lessons)} · ${c.hours}</li>
    </ul>
    <div class="p-card__foot">${priceHtml(c)}${addBtnHtml(c)}</div>
  </article>`;
}
function rowHtml(c){
  const cat = CATS[c.cat];
  return `
  <tr data-id="${c.id}">
    <td class="t-title">${c.title}</td>
    <td><span class="tag tag--${cat.cls}">${cat.label}</span></td>
    <td class="t-muted">${c.instructor}</td>
    <td>${priceHtml(c)}</td>
    <td>${addBtnHtml(c)}</td>
  </tr>`;
}
function renderCourses(){
  const list = COURSES.filter(c => (state.expanded || !c.extra) && (state.cat === 'all' || c.cat === state.cat));
  $('#courseGrid').innerHTML = list.map(cardHtml).join('');
  $('#courseTableBody').innerHTML = list.map(rowHtml).join('');
  $$('.add-cart').forEach(b => {
    const on = cart.has(b.dataset.name);
    b.classList.toggle('added', on);
    b.innerHTML = on ? LBL_ADDED : LBL_ADD;
  });
}
function setView(v){
  state.view = v;
  $$('#viewSeg button').forEach(b => b.classList.toggle('active', b.dataset.view === v));
  $('#courseGrid').hidden = v !== 'grid';
  $('#courseTable').hidden = v !== 'table';
  renderCourses();
}
 $$('#viewSeg button').forEach(b => b.addEventListener('click', () => setView(b.dataset.view)));
 $$('#catChips .chip').forEach(ch => ch.addEventListener('click', () => {
  state.cat = ch.dataset.cat;
  $$('#catChips .chip').forEach(x => x.classList.toggle('chip--on', x === ch));
  renderCourses();
}));
 $('#loadMore').addEventListener('click', () => {
  state.expanded = true;
  renderCourses();
  $('#loadMore').hidden = true;
  $('#allShown').hidden = false;
});
renderCourses();

/* ---------------- Command palette ---------------- */
function buildIndex(){
  const sec = (label, icon, target) => ({ label, icon, run: () => { const t = $(target); t && t.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth' }); } });
  return [
    { group:'التنقل', items:[
      sec('الدورات','book-open','#courses'), sec('الدبلومات','grad-cap','#diplomas'),
      sec('الباقات','layers','#bundles'), sec('لماذا ماستري؟','award','#features'),
      sec('الأسئلة الشائعة','message','#faq'), sec('التحقق من الشهادة','shield','#verify'),
    ]},
    { group:'الدورات', items: COURSES.map(c => ({
      label:c.title, icon:CATS[c.cat].icon,
      sub:`${CATS[c.cat].label} · ${c.price ? '$'+c.price : 'مجاني'}`,
      run:() => openCourse(c.id),
    }))},
    { group:'الدبلومات', items:[
      { label:'دبلوم التسويق الاحترافي التدريبي', icon:'grad-cap', sub:'$775', run:() => flashEl('#dip-1') },
      { label:'إتقان المبيعات — الدفعة السادسة', icon:'grad-cap', sub:'$520', run:() => flashEl('#dip-2') },
      { label:'دبلوم الرسم الاحترافي التدريبي', icon:'grad-cap', sub:'$775', run:() => flashEl('#dip-3') },
    ]},
    { group:'الباقات', items:[
      { label:'باقة التسويق والتجارة الإلكترونية', icon:'layers', sub:'$625', run:() => flashEl('#b-1') },
      { label:'دبلوم التخطيط الاستراتيجي', icon:'layers', sub:'$459', run:() => flashEl('#b-2') },
    ]},
    { group:'إجراءات', items:[
      { label:'تسجيل الدخول', icon:'user', run:() => showModal('login') },
      { label:'طلبات الشركات', icon:'briefcase', run:() => showModal('corporate') },
      { label:'انضم لنا كمدرب', icon:'mic', run:() => showModal('instructor') },
      { label:'تواصل معنا', icon:'mail', run:() => showModal('contact') },
      { label:'تبديل المظهر (فاتح / داكن)', icon:'moon', run:toggleTheme },
    ]},
  ];
}
const INDEX = buildIndex();
let palItems = [], palActive = 0;

function renderPal(q){
  q = q.trim();
  palItems = [];
  let html = '';
  INDEX.forEach(g => {
    const items = g.items.filter(it => !q || it.label.includes(q));
    if (!items.length) return;
    html += `<div class="pal-group">${g.group}</div>`;
    items.forEach(it => {
      html += `<div class="pal-item" data-idx="${palItems.length}"><svg class="i"><use href="#i-${it.icon}"/></svg><span>${it.label}</span>${it.sub ? `<span class="pal-sub" dir="auto">${it.sub}</span>` : ''}</div>`;
      palItems.push(it);
    });
  });
  palActive = 0;
  paletteResults.innerHTML = palItems.length ? html : `<div class="pal-empty">لا توجد نتائج لـ «${q}»</div>`;
  paintActive();
}
function paintActive(){
  $$('.pal-item', paletteResults).forEach(el => el.classList.toggle('sel', +el.dataset.idx === palActive));
  const sel = $('.pal-item.sel', paletteResults);
  sel && sel.scrollIntoView({ block:'nearest' });
}
function openPalette(){
  closeAllLayers();
  paletteWrap.classList.add('show'); lock(true);
  paletteInput.value = ''; renderPal('');
  setTimeout(() => paletteInput.focus(), 50);
}
paletteInput.addEventListener('input', () => renderPal(paletteInput.value));
paletteInput.addEventListener('keydown', e => {
  if (e.key === 'ArrowDown'){ e.preventDefault(); if (palItems.length){ palActive = (palActive + 1) % palItems.length; paintActive(); } }
  else if (e.key === 'ArrowUp'){ e.preventDefault(); if (palItems.length){ palActive = (palActive - 1 + palItems.length) % palItems.length; paintActive(); } }
  else if (e.key === 'Enter'){ e.preventDefault(); const it = palItems[palActive]; if (it){ closeAllLayers(); setTimeout(() => it.run(), 60); } }
});
paletteResults.addEventListener('click', e => {
  const item = e.target.closest('.pal-item');
  if (!item) return;
  const it = palItems[+item.dataset.idx];
  closeAllLayers(); setTimeout(() => it.run(), 60);
});
paletteResults.addEventListener('mouseover', e => {
  const item = e.target.closest('.pal-item');
  if (item){ palActive = +item.dataset.idx; paintActive(); }
});
 $('#searchTrigger').addEventListener('click', openPalette);

function flashEl(sel){
  const el = $(sel);
  if (!el) return;
  el.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block:'center' });
  setTimeout(() => { el.classList.add('flash'); setTimeout(() => el.classList.remove('flash'), 1500); }, 350);
}
function openCourse(id){
  const c = COURSES.find(x => x.id === id);
  if (!c) return;
  if (c.extra && !state.expanded){
    state.expanded = true;
    $('#loadMore').hidden = true; $('#allShown').hidden = false;
  }
  if (state.cat !== 'all'){
    state.cat = 'all';
    $$('#catChips .chip').forEach(x => x.classList.toggle('chip--on', x.dataset.cat === 'all'));
  }
  if (state.view !== 'grid') setView('grid'); else renderCourses();
  setTimeout(() => flashEl(`#courseGrid [data-id="${id}"]`), 150);
}

/* ---------------- Modal system ---------------- */
const MODALS = {
  login:{ title:'تسجيل الدخول', sub:'سنرسل لك رابط دخول آمناً إلى بريدك الإلكتروني — بدون كلمة مرور.',
    fields:[{name:'email',label:'البريد الإلكتروني',type:'email',required:true,placeholder:'name@example.com'}],
    submit:'أرسل رابط الدخول',
    success:{title:'تحقق من بريدك',msg:'أرسلنا رابط الدخول إلى بريدك الإلكتروني، وصلاحيته 15 دقيقة.'},
    toastMsg:'تم إرسال رابط الدخول' },
  instructor:{ title:'انضم إلينا كمدرب', sub:'كن أحد الخبراء في ماستري أكاديمي وانشر محتواك لآلاف المتدربين.',
    fields:[
      {name:'name',label:'الاسم الكامل',type:'text',required:true,placeholder:'اسمك الكامل'},
      {name:'email',label:'البريد الإلكتروني',type:'email',required:true,placeholder:'name@example.com'},
      {name:'field',label:'مجال الخبرة',type:'text',required:true,placeholder:'مثال: التسويق الرقمي، القانون، الإدارة…'}],
    submit:'إرسال طلب الانضمام',
    success:{title:'تم استلام طلبك',msg:'شكراً لاهتمامك! سيراجع فريقنا ملفك ويتواصل معك خلال 48 ساعة.'},
    toastMsg:'تم إرسال طلب الانضمام' },
  corporate:{ title:'طلبات الشركات', sub:'درب فريقك مع برامج مخصصة للشركات — أخبرنا باحتياجك وسيتواصل معك فريقنا.',
    fields:[
      {name:'org',label:'اسم الجهة',type:'text',required:true,placeholder:'اسم الشركة أو الجهة'},
      {name:'email',label:'البريد الرسمي',type:'email',required:true,placeholder:'name@company.com'},
      {name:'size',label:'عدد المتدربين المتوقع',type:'text',required:false,placeholder:'مثال: 25'}],
    submit:'إرسال الطلب',
    success:{title:'تم استلام طلبكم',msg:'شكراً لتواصلكم! سيتواصل معكم فريق الشراكات خلال يوم عمل واحد.'},
    toastMsg:'تم إرسال طلب الشركة' },
  affiliate:{ title:'التسويق بالعمولة', sub:'انشر دورات ماستري واكسب عمولة على كل عملية شراء تتم عبر رابطك.',
    fields:[
      {name:'name',label:'الاسم الكامل',type:'text',required:true,placeholder:'اسمك الكامل'},
      {name:'email',label:'البريد الإلكتروني',type:'email',required:true,placeholder:'name@example.com'},
      {name:'channel',label:'قنواتك الحالية',type:'text',required:false,placeholder:'مثال: يوتيوب، انستغرام، مدونة…'}],
    submit:'تقديم طلب الانضمام',
    success:{title:'تم استلام طلبك',msg:'سنراسلك بالتفاصيل ورابط الإحالة الخاص بك بعد المراجعة.'},
    toastMsg:'تم إرسال طلب العمولة' },
  contact:{ title:'تواصل معنا', sub:'فريق خدمة العملاء متاح من الأحد إلى الخميس، 9 صباحاً – 6 مساءً.',
    fields:[
      {name:'name',label:'الاسم',type:'text',required:true,placeholder:'اسمك'},
      {name:'email',label:'البريد الإلكتروني',type:'email',required:true,placeholder:'name@example.com'},
      {name:'msg',label:'رسالتك',type:'textarea',required:true,placeholder:'كيف نساعدك؟'}],
    submit:'إرسال الرسالة',
    success:{title:'وصلتنا رسالتك',msg:'شكراً لتواصلك! سنرد على بريدك في أقرب وقت.'},
    toastMsg:'تم إرسال الرسالة' },
  consult:{ title:'حجز استشارة', sub:'جلسة فردية مع أحد خبرائنا المعتمدين حسب مجالك.',
    fields:[
      {name:'name',label:'الاسم',type:'text',required:true,placeholder:'اسمك'},
      {name:'email',label:'البريد الإلكتروني',type:'email',required:true,placeholder:'name@example.com'},
      {name:'topic',label:'مجال الاستشارة',type:'text',required:true,placeholder:'مثال: التخطيط الاستراتيجي'}],
    submit:'طلب حجز استشارة',
    success:{title:'تم استلام طلبك',msg:'سنتواصل معك لتحديد الموعد المناسب.'},
    toastMsg:'تم إرسال طلب الاستشارة' },
  news:{ title:'النشرة البريدية', sub:'أحدث الدورات والعروض الحصرية — رسالة واحدة أسبوعياً.',
    fields:[{name:'email',label:'البريد الإلكتروني',type:'email',required:true,placeholder:'name@example.com'}],
    submit:'اشترك في النشرة',
    success:{title:'تم الاشتراك',msg:'أهلاً بك! أول رسالة ستصلك قريباً.'},
    toastMsg:'تم تسجيل بريدك في النشرة' },
};

function showModal(key){
  const cfg = MODALS[key];
  if (!cfg) return;
  closeAllLayers();
  modalBody.innerHTML = `
    <h3 class="modal__title">${cfg.title}</h3>
    <p class="modal__sub">${cfg.sub || ''}</p>
    <form class="modal__form" novalidate>
      ${cfg.fields.map(f => `
        <label class="field">
          <span>${f.label}${f.required ? ' <em>*</em>' : ''}</span>
          ${f.type === 'textarea'
            ? `<textarea name="${f.name}" rows="3" placeholder="${f.placeholder || ''}"></textarea>`
            : `<input name="${f.name}" type="${f.type}" placeholder="${f.placeholder || ''}" ${f.type === 'email' ? 'dir="ltr"' : ''}>`}
          <small class="field__err" hidden></small>
        </label>`).join('')}
      <button type="submit" class="btn btn--primary btn--block">${cfg.submit}</button>
    </form>`;
  modalWrap.classList.add('show'); lock(true);

  const form = $('form', modalBody);
  form.addEventListener('submit', e => {
    e.preventDefault();
    let ok = true;
    cfg.fields.forEach(f => {
      const input = form.elements[f.name];
      const err = input.closest('.field').querySelector('.field__err');
      let msg = '';
      if (f.required && !input.value.trim()) msg = 'هذا الحقل مطلوب';
      else if (f.type === 'email' && input.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(input.value.trim())) msg = 'أدخل بريداً إلكترونياً صحيحاً';
      err.hidden = !msg; err.textContent = msg;
      input.classList.toggle('invalid', !!msg);
      if (msg) ok = false;
    });
    if (!ok) return;
    modalBody.innerHTML = `
      <div class="modal__success">
        <span class="tile tile--green tile--lg"><svg class="i"><use href="#i-check"/></svg></span>
        <h3>${cfg.success.title}</h3><p>${cfg.success.msg}</p>
      </div>`;
    toast(cfg.toastMsg);
    setTimeout(closeAllLayers, 2200);
  });
  setTimeout(() => { const first = modalBody.querySelector('input,textarea'); first && first.focus(); }, 80);
}

/* ---------------- Global delegation ---------------- */
document.addEventListener('click', e => {
  const m = e.target.closest('[data-modal]');
  if (m){ e.preventDefault(); showModal(m.dataset.modal); return; }
  const f = e.target.closest('[data-faq]');
  if (f){ e.preventDefault(); openFaqByIndex(+f.dataset.faq); return; }
  const s = e.target.closest('[data-scroll]');
  if (s){ e.preventDefault(); closeAllLayers(); const t = $(s.dataset.scroll); t && t.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth' }); return; }
  if (e.target.closest('[data-close]')) closeAllLayers();
});
 $('#menuBtn').addEventListener('click', () => { closeAllLayers(); navDrawer.classList.add('open'); scrim.classList.add('show'); lock(true); });

/* ---------------- FAQ toggles ---------------- */
function toggleFaq(item){
  const wasOpen = item.classList.contains('open');
  $$('#faqList .faq').forEach(f => {
    f.classList.remove('open');
    f.querySelector('.faq__q').setAttribute('aria-expanded','false');
  });
  if (!wasOpen){
    item.classList.add('open');
    item.querySelector('.faq__q').setAttribute('aria-expanded','true');
  }
}
 $$('#faqList .faq__q').forEach(btn => btn.addEventListener('click', () => toggleFaq(btn.closest('.faq'))));
function openFaqByIndex(i){
  const item = $$('#faqList .faq')[i];
  if (!item) return;
  closeAllLayers();
  $$('#faqList .faq').forEach(f => { f.classList.remove('open'); f.querySelector('.faq__q').setAttribute('aria-expanded','false'); });
  item.classList.add('open');
  item.querySelector('.faq__q').setAttribute('aria-expanded','true');
  item.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block:'center' });
}

/* ---------------- Certificate verification ---------------- */
 $('#verifyForm').addEventListener('submit', e => {
  e.preventDefault();
  const raw = $('#certInput').value.replace(/\s+/g,'').toUpperCase();
  const out = $('#verifyResult');
  const errHtml = msg => `<div class="verify-err"><svg class="i i-sm"><use href="#i-close"/></svg> ${msg}</div>`;
  if (!raw){ out.innerHTML = errHtml('أدخل رقم الشهادة أولاً.'); return; }
  if (!/^MA-\d{4}-\d{4}$/.test(raw)){ out.innerHTML = errHtml('صيغة الرقم غير صحيحة — الصيغة الصحيحة: <span dir="ltr">MA-2025-4821</span>'); return; }
  const c = CERTS[raw];
  out.innerHTML = c
    ? `<div class="verify-card">
         <span class="tile tile--green"><svg class="i"><use href="#i-check"/></svg></span>
         <div><strong>شهادة صالحة ومسجلة لدينا</strong>
           <ul class="meta">
             <li><svg class="i i-xs"><use href="#i-user"/></svg> ${c.name}</li>
             <li><svg class="i i-xs"><use href="#i-book-open"/></svg> ${c.program}</li>
             <li><svg class="i i-xs"><use href="#i-calendar"/></svg> تاريخ الإصدار: ${c.date}</li>
           </ul>
         </div>
       </div>`
    : errHtml('لم نعثر على شهادة بهذا الرقم — تأكد من الرقم أو تواصل معنا.');
});

/* ---------------- Metric counters ---------------- */
function animateCount(el){
  const target = +el.dataset.count, pre = el.dataset.prefix || '', dur = 1300, t0 = performance.now();
  (function tick(t){
    const p = Math.min((t - t0) / dur, 1), e = 1 - Math.pow(1 - p, 3);
    el.textContent = pre + Math.round(target * e).toLocaleString('en-US');
    if (p < 1) requestAnimationFrame(tick);
  })(t0);
}
const metricsIO = new IntersectionObserver(entries => {
  entries.forEach(en => {
    if (!en.isIntersecting) return;
    $$('[data-count]', en.target).forEach(animateCount);
    metricsIO.unobserve(en.target);
  });
}, { threshold:.4 });
metricsIO.observe($('#metrics'));

/* ---------------- Scroll reveal ---------------- */
const revealIO = new IntersectionObserver(entries => {
  entries.forEach(en => {
    if (en.isIntersecting){ en.target.classList.add('is-in'); revealIO.unobserve(en.target); }
  });
}, { threshold:.12, rootMargin:'0px 0px -40px' });
 $$('[data-reveal]').forEach(el => prefersReduced ? el.classList.add('is-in') : revealIO.observe(el));

/* ---------------- Keyboard shortcuts ---------------- */
document.addEventListener('keydown', e => {
  if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k'){
    e.preventDefault();
    paletteWrap.classList.contains('show') ? closeAllLayers() : openPalette();
    return;
  }
  if (e.key === 'Escape') closeAllLayers();
});

renderCart();
})();
</script>
</body>
</html>