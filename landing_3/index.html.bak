    <button type="button" class="icon-btn" data-close aria-label="إغلاق"><svg class="i"><use href="#i-close"/></svg></button>
  </div>
  <nav class="drawer__nav">
    <a href="#courses" data-close>جميع الأقسام</a>
    <button type="button" data-modal="corporate">طلبات الشركات</button>
    <button type="button" data-modal="affiliate">التسويق بالعمولة</button>
    <a href="#verify" data-close>التحقق من الشهادة</a>
    <button type="button" data-modal="instructor">انضم لنا كمدرب</button>
  </nav>
  <div class="drawer__actions">
    <button type="button" class="btn btn--secondary" data-modal="login">تسجيل الدخول</button>
    <a class="btn btn--primary" href="#courses" data-close>اشترك الآن</a>
  </div>
</aside>

<!-- Cart drawer -->
<aside class="drawer drawer--end" id="cartDrawer" aria-label="سلة المشتريات">
  <div class="drawer__head">
    <strong id="cartTitle">سلة المشتريات</strong>
    <button type="button" class="icon-btn" data-close aria-label="إغلاق"><svg class="i"><use href="#i-close"/></svg></button>
  </div>
