<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ماستري أكاديمي — تعلم ما يغير عالمك</title>
<meta name="description" content="منصة التعلم الرائدة في الوطن العربي — دورات، دبلومات وباقات احترافية معتمدة دولياً.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ============================================================
   MASTERY ACADEMY — Notion-like Design System
   All UI decisions resolve to a token. Nothing is hard-coded.
   ============================================================ */

/* ---------- 1 · Color tokens ---------- */
:root{
  /* surfaces & ink */
  --bg:#FFFFFF;            /* page */
  --bg-subtle:#F7F7F5;     /* panels, footer, table header */
  --bg-hover:#F1F1EF;      /* hover fills, secondary buttons */
  --bg-active:#E9E8E4;
  --ink:#37352F;           /* primary text */
  --ink-2:#787774;         /* secondary text */
  --ink-3:#9B9A97;         /* tertiary / placeholders */
  --line:#E9E9E7;          /* hairline borders */
  --line-strong:#D6D4CF;
  --header-blur:rgba(255,255,255,.82);
  --inverse-bg:#37352F;    /* selected chips, toasts, logo mark */
  --inverse-ink:#FFFFFF;
  --scrim:rgba(15,15,15,.46);

  /* accent & status */
  --accent:#2383E2;
  --accent-hover:#1B74CC;
  --accent-soft:rgba(35,131,226,.09);
  --success:#0F7B6C;
  --danger:#D44C47;

  /* Notion-style tag palette (soft bg + saturated fg) */
  --tint-blue-bg:rgba(35,131,226,.09);   --tint-blue-fg:#2383E2;
  --tint-green-bg:rgba(15,123,108,.09);  --tint-green-fg:#0F7B6C;
  --tint-orange-bg:rgba(217,115,13,.10); --tint-orange-fg:#D9730D;
  --tint-purple-bg:rgba(144,101,216,.10);--tint-purple-fg:#9065D0;
  --tint-pink-bg:rgba(173,26,114,.08);   --tint-pink-fg:#AD1A72;
  --tint-yellow-bg:rgba(203,145,47,.13); --tint-yellow-fg:#A07708;

  /* ---------- 2 · Typography ---------- */
  --font:'IBM Plex Sans Arabic','Segoe UI',Tahoma,sans-serif;
  --fs-xs:12px; --fs-sm:13.5px; --fs-md:15px; --fs-lg:17px;
  --lh:1.75;

  /* ---------- 3 · Spacing scale (4px base) ---------- */
  --sp-1:4px;  --sp-2:8px;  --sp-3:12px; --sp-4:16px;
  --sp-5:20px; --sp-6:24px; --sp-8:32px; --sp-10:40px;
  --sp-12:48px; --sp-16:64px; --sp-20:80px; --sp-24:96px;

  /* ---------- 4 · Radius ---------- */
  --r-sm:4px; --r-md:6px; --r-lg:10px; --r-full:999px;

  /* ---------- 5 · Elevation ---------- */
  --sh-card:0 1px 2px rgba(15,15,15,.03),0 2px 8px rgba(15,15,15,.05);
  --sh-pop:0 0 0 1px rgba(15,15,15,.05),0 10px 24px rgba(15,15,15,.10),0 24px 56px rgba(15,15,15,.10);
  --sh-toast:0 4px 14px rgba(15,15,15,.22);

  /* ---------- 6 · Motion ---------- */
  --ease:cubic-bezier(.22,1,.36,1);
  --fast:140ms; --base:220ms; --slow:420ms;

  /* ---------- 7 · Layout ---------- */
  --container:1120px;
  --header-h:64px;
  color-scheme:light;
}

/* ---------- Dark theme: only tokens change ---------- */
[data-theme="dark"]{
  --bg:#191919;
  --bg-subtle:#202020;
  --bg-hover:#282827;
  --bg-active:#303030;
  --ink:#D6D5D2;
  --ink-2:#9B9B98;
  --ink-3:#6E6E6B;
  --line:#2D2D2B;
  --line-strong:#3D3D3B;
  --header-blur:rgba(25,25,25,.82);
  --inverse-bg:#E9E9E6;
  --inverse-ink:#1E1E1D;
  --scrim:rgba(0,0,0,.55);
  --accent-soft:rgba(35,131,226,.16);
  --tint-blue-bg:rgba(70,150,220,.16);   --tint-blue-fg:#6FB0E8;
  --tint-green-bg:rgba(50,150,120,.15);  --tint-green-fg:#5FB39A;
  --tint-orange-bg:rgba(220,140,60,.14); --tint-orange-fg:#E89B5B;
  --tint-purple-bg:rgba(150,110,210,.15);--tint-purple-fg:#B48CE0;
  --tint-pink-bg:rgba(210,90,150,.14);   --tint-pink-fg:#DE85B4;
  --tint-yellow-bg:rgba(210,160,60,.14); --tint-yellow-fg:#DDB05F;
  --sh-card:0 1px 2px rgba(0,0,0,.2),0 2px 8px rgba(0,0,0,.25);
  --sh-pop:0 0 0 1px rgba(255,255,255,.06),0 10px 24px rgba(0,0,0,.35),0 24px 56px rgba(0,0,0,.35);
  color-scheme:dark;
}

/* ---------- Reset & base ---------- */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:88px}
body{
  font-family:var(--font);font-size:15.5px;line-height:var(--lh);
  background:var(--bg);color:var(--ink);
  -webkit-font-smoothing:antialiased;
}
body.locked{overflow:hidden}
img,svg{display:block}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
input,textarea{font:inherit;color:var(--ink)}
::selection{background:rgba(35,131,226,.20)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:var(--r-sm)}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-thumb{background:var(--line-strong);border-radius:8px;border:2px solid var(--bg)}
::-webkit-scrollbar-track{background:transparent}

/* icons — stroke set inherits from the <svg class="i"> */
.i{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.i-xs{width:14px;height:14px}
.i-sm{width:16px;height:16px}
.i-lg{width:26px;height:26px}
.i-fill{fill:currentColor;stroke:none}

/* ---------- Layout primitives ---------- */
.container{width:min(100% - 48px,var(--container));margin-inline:auto}
.container--narrow{max-width:780px}
.section{padding-block:var(--sp-24)}
.section--rule{border-top:1px solid var(--line)}
section[id]{scroll-margin-top:88px}
.kicker{display:inline-flex;align-items:center;gap:8px;font-size:var(--fs-sm);font-weight:500;color:var(--ink-3)}
.kicker .i{width:15px;height:15px}
h2{font-size:clamp(22px,3vw,30px);font-weight:700;line-height:1.4;margin:var(--sp-2) 0 var(--sp-2)}
.section-desc{color:var(--ink-2);font-size:var(--fs-md);max-width:560px}
.section-head{margin-bottom:var(--sp-10)}
.section-head--split{display:flex;justify-content:space-between;align-items:flex-end;gap:var(--sp-6);flex-wrap:wrap}

/* ---------- Components: buttons ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  height:38px;padding-inline:16px;border-radius:var(--r-md);
  font-size:14px;font-weight:500;white-space:nowrap;
  transition:background var(--fast) var(--ease),color var(--fast) var(--ease),border-color var(--fast),box-shadow var(--fast),opacity var(--fast);
}
.btn:active{transform:scale(.985)}
.btn--primary{background:var(--accent);color:#fff}
.btn--primary:hover{background:var(--accent-hover)}
.btn--secondary{background:var(--bg-hover);color:var(--ink)}
.btn--secondary:hover{background:var(--bg-active)}
.btn--sm{height:32px;padding-inline:12px;font-size:13px}
.btn--lg{height:44px;padding-inline:22px;font-size:15px}
.btn--block{width:100%}
.btn:disabled{opacity:.5;cursor:default;transform:none}

.icon-btn{
  width:36px;height:36px;border-radius:var(--r-md);display:grid;place-items:center;
  color:var(--ink-2);transition:background var(--fast),color var(--fast);
}
.icon-btn:hover{background:var(--bg-hover);color:var(--ink)}
.icon-btn--xs{width:26px;height:26px;color:var(--ink-3)}
.icon-btn--xs:hover{color:var(--danger)}
kbd{
  font-family:var(--font);font-size:11px;color:var(--ink-3);
  border:1px solid var(--line);border-bottom-width:2px;border-radius:var(--r-sm);
  padding:1px 6px;background:var(--bg-subtle);
}

/* ---------- Components: tags, tiles, meta ---------- */
.tag{display:inline-flex;align-items:center;font-size:var(--fs-xs);font-weight:500;padding:2px 8px;border-radius:var(--r-sm)}
.tag--blue{background:var(--tint-blue-bg);color:var(--tint-blue-fg)}
.tag--green{background:var(--tint-green-bg);color:var(--tint-green-fg)}
.tag--orange{background:var(--tint-orange-bg);color:var(--tint-orange-fg)}
.tag--purple{background:var(--tint-purple-bg);color:var(--tint-purple-fg)}
.tag--pink{background:var(--tint-pink-bg);color:var(--tint-pink-fg)}
.tag--yellow{background:var(--tint-yellow-bg);color:var(--tint-yellow-fg)}

.tile{width:40px;height:40px;border-radius:var(--r-md);display:grid;place-items:center;flex:none}
.tile .i{width:20px;height:20px}
.tile--blue{background:var(--tint-blue-bg);color:var(--tint-blue-fg)}
.tile--green{background:var(--tint-green-bg);color:var(--tint-green-fg)}
.tile--orange{background:var(--tint-orange-bg);color:var(--tint-orange-fg)}
.tile--purple{background:var(--tint-purple-bg);color:var(--tint-purple-fg)}
.tile--pink{background:var(--tint-pink-bg);color:var(--tint-pink-fg)}
.tile--yellow{background:var(--tint-yellow-bg);color:var(--tint-yellow-fg)}
.tile--lg{width:52px;height:52px}

.meta{list-style:none;display:grid;gap:6px;font-size:var(--fs-sm);color:var(--ink-2)}
.meta li{display:flex;align-items:center;gap:7px}
.meta .i{color:var(--ink-3)}

.price{font-weight:600;font-size:15px}
.price--free{color:var(--tint-green-fg)}
.price--lg{font-size:24px;font-weight:700}
.price-old{text-decoration:line-through;color:var(--ink-3);font-size:14px}

/* ---------- Header ---------- */
.site-header{
  position:sticky;top:0;z-index:50;height:var(--header-h);
  background:var(--header-blur);
  -webkit-backdrop-filter:blur(12px) saturate(1.4);backdrop-filter:blur(12px) saturate(1.4);
  border-bottom:1px solid var(--line);
}
.header-inner{height:100%;display:flex;align-items:center;gap:var(--sp-5)}
.brand{display:flex;align-items:center;gap:10px;font-weight:600;font-size:15px}
.brand__mark{width:28px;height:28px;border-radius:var(--r-md);background:var(--ink);color:var(--bg);display:grid;place-items:center;flex:none}
.brand__mark .i{width:16px;height:16px}
.main-nav{display:flex;gap:2px}
.main-nav a,.main-nav button{
  padding:6px 10px;border-radius:var(--r-md);font-size:14px;font-weight:500;color:var(--ink-2);
  transition:background var(--fast),color var(--fast);
}
.main-nav a:hover,.main-nav button:hover{background:var(--bg-hover);color:var(--ink)}
.header-actions{margin-inline-start:auto;display:flex;align-items:center;gap:var(--sp-2)}
.header-search{
  display:flex;align-items:center;gap:8px;height:34px;padding-inline:10px;
  border:1px solid var(--line);border-radius:var(--r-md);color:var(--ink-3);font-size:13px;
  transition:background var(--fast),color var(--fast);
}
.header-search:hover{background:var(--bg-hover);color:var(--ink-2)}
.menu-btn{display:none}

/* ---------- Mobile drawer ---------- */
.scrim{position:fixed;inset:0;background:var(--scrim);opacity:0;pointer-events:none;transition:opacity var(--base) var(--ease);z-index:60}
.scrim.show{opacity:1;pointer-events:auto}
.drawer{
  position:fixed;top:0;bottom:0;width:min(320px,88vw);background:var(--bg);z-index:61;
  display:flex;flex-direction:column;padding:var(--sp-5);
  transition:transform var(--slow) var(--ease);
}
.drawer--start{inset-inline-start:0;border-inline-end:1px solid var(--line);transform:translateX(105%)}
.drawer--end{inset-inline-end:0;border-inline-start:1px solid var(--line);transform:translateX(-105%)}
[dir="rtl"] .drawer--start{transform:translateX(105%)}
[dir="rtl"] .drawer--end{transform:translateX(-105%)}
.drawer.open{transform:none!important}
.drawer__head{display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--sp-5)}
.drawer__nav{display:grid;gap:2px}
.drawer__nav a,.drawer__nav button{
  text-align:start;padding:11px 12px;border-radius:var(--r-md);font-size:15px;font-weight:500;color:var(--ink-2);
}
.drawer__nav a:hover,.drawer__nav button:hover{background:var(--bg-hover);color:var(--ink)}
.drawer__actions{margin-top:auto;display:grid;gap:10px;padding-top:var(--sp-5);border-top:1px solid var(--line)}

/* ---------- Hero ---------- */
.hero{padding-block:var(--sp-20) var(--sp-16)}
.crumbs{display:flex;align-items:center;gap:6px;font-size:var(--fs-sm);color:var(--ink-3);margin-bottom:var(--sp-10)}
.crumbs .i{width:13px;height:13px}
.crumbs a:hover{color:var(--ink)}
.crumbs .cur{color:var(--ink-2);font-weight:500}
.hero-label{
  display:inline-flex;align-items:center;gap:9px;padding:6px 14px;margin-bottom:var(--sp-5);
  background:var(--bg-subtle);border:1px solid var(--line);border-radius:var(--r-full);
  font-size:var(--fs-sm);font-weight:500;color:var(--ink-2);
}
.dot{width:7px;height:7px;border-radius:50%;background:var(--success);animation:pulse 2.6s infinite}
@keyframes pulse{
  0%{box-shadow:0 0 0 0 rgba(15,123,108,.35)}
  70%{box-shadow:0 0 0 9px rgba(15,123,108,0)}
  100%{box-shadow:0 0 0 0 rgba(15,123,108,0)}
}
.hero-title{font-size:clamp(42px,7vw,68px);font-weight:700;line-height:1.15;letter-spacing:-.01em;margin-bottom:var(--sp-3)}
.hero-sub{font-size:clamp(18px,2.4vw,23px);font-weight:500;color:var(--ink);margin-bottom:var(--sp-2)}
.hero-meta{display:flex;align-items:center;gap:var(--sp-4);color:var(--ink-3);font-size:var(--fs-sm);margin-bottom:var(--sp-8)}
.hero-meta span{display:inline-flex;align-items:center;gap:6px}
.hero-actions{display:flex;gap:var(--sp-3);flex-wrap:wrap;margin-bottom:var(--sp-12)}
.hero-metrics{display:flex;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:var(--sp-6);gap:var(--sp-8)}
.metric{display:flex;align-items:center;gap:12px}
.metric .i{width:22px;height:22px;color:var(--ink-3)}
.metric strong{display:block;font-size:22px;font-weight:700;line-height:1.2}
.metric small{font-size:var(--fs-sm);color:var(--ink-2)}
.metric + .metric{border-inline-start:1px solid var(--line);padding-inline-start:var(--sp-8)}

/* ---------- Database controls (chips + view switch) ---------- */
.db-controls{display:flex;align-items:center;gap:var(--sp-3);flex-wrap:wrap}
.chips{display:flex;gap:4px;flex-wrap:wrap}
.chip{padding:6px 14px;border-radius:var(--r-full);font-size:13px;font-weight:500;color:var(--ink-2);transition:background var(--fast),color var(--fast)}
.chip:hover{background:var(--bg-hover)}
.chip--on{background:var(--inverse-bg);color:var(--inverse-ink)}
.seg{display:inline-flex;gap:2px;padding:2px;background:var(--bg-subtle);border:1px solid var(--line);border-radius:var(--r-md)}
.seg button{width:30px;height:28px;display:grid;place-items:center;border-radius:var(--r-sm);color:var(--ink-3)}
.seg button:hover{color:var(--ink-2)}
.seg button.active{background:var(--bg);color:var(--ink);box-shadow:var(--sh-card)}

/* ---------- Course cards (gallery view) ---------- */
.course-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--sp-5)}
.p-card{
  display:flex;flex-direction:column;gap:var(--sp-4);padding:var(--sp-5);
  background:var(--bg);border:1px solid var(--line);border-radius:var(--r-lg);
  animation:cardIn .45s var(--ease) both;
  transition:box-shadow var(--base) var(--ease),border-color var(--base);
}
.p-card:hover{border-color:var(--line-strong);box-shadow:var(--sh-card)}
@keyframes cardIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.p-card__head{display:flex;justify-content:space-between;align-items:flex-start}
.p-card__tags{display:flex;gap:6px}
.p-card__title{font-size:16px;font-weight:600;line-height:1.5}
.p-card__foot{margin-top:auto;display:flex;justify-content:space-between;align-items:center;padding-top:var(--sp-4);border-top:1px solid var(--line)}
.add-cart.added{background:var(--tint-green-bg);color:var(--tint-green-fg)}

/* ---------- Course table view ---------- */
.course-table{border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;overflow-x:auto}
.course-table table{width:100%;border-collapse:collapse;min-width:600px}
.course-table th{
  text-align:start;font-size:var(--fs-xs);font-weight:500;color:var(--ink-3);
  background:var(--bg-subtle);padding:10px var(--sp-4);border-bottom:1px solid var(--line);
}
.course-table td{padding:12px var(--sp-4);border-bottom:1px solid var(--line);font-size:14px}
.course-table tbody tr:last-child td{border-bottom:0}
.course-table tbody tr{transition:background var(--fast)}
.course-table tbody tr:hover{background:var(--bg-subtle)}
.t-title{font-weight:500}
.t-muted{color:var(--ink-2);font-size:13.5px}
[hidden]{display:none!important}

.section-more{display:flex;justify-content:center;margin-top:var(--sp-10)}
.all-shown{font-size:var(--fs-sm);color:var(--ink-3)}

/* ---------- Diplomas ---------- */
.d-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:var(--sp-5)}
.d-card{
  display:flex;flex-direction:column;gap:var(--sp-4);padding:var(--sp-6);
  background:var(--bg);border:1px solid var(--line);border-radius:var(--r-lg);
  transition:box-shadow var(--base),border-color var(--base);
}
.d-card:hover{border-color:var(--line-strong);box-shadow:var(--sh-card)}
.d-card h3{font-size:17px;font-weight:600;line-height:1.5}
.d-card__top{display:flex;justify-content:space-between;align-items:flex-start}
.d-card .p-foot{margin-top:auto;display:flex;justify-content:space-between;align-items:center;padding-top:var(--sp-4);border-top:1px solid var(--line)}

/* ---------- Bundles ---------- */
.b-stack{display:grid;gap:var(--sp-5)}
.b-card{
  display:flex;justify-content:space-between;align-items:center;gap:var(--sp-8);
  padding:var(--sp-6);border:1px solid var(--line);border-radius:var(--r-lg);background:var(--bg);
  transition:box-shadow var(--base),border-color var(--base);
}
.b-card:hover{border-color:var(--line-strong);box-shadow:var(--sh-card)}
.b-card__main{display:flex;gap:var(--sp-5);align-items:flex-start}
.b-card__main h3{font-size:17px;font-weight:600;margin-bottom:var(--sp-2)}
.meta--row{display:flex;flex-wrap:wrap;gap:var(--sp-4)}
.b-card__price{
  display:flex;flex-direction:column;align-items:flex-start;gap:6px;justify-content:center;
  border-inline-start:1px solid var(--line);padding-inline-start:var(--sp-8);min-width:190px;
}
.b-card__price .btn{margin-top:var(--sp-2)}

/* ---------- Features (sticky split) ---------- */
.features-grid{display:grid;grid-template-columns:minmax(280px,380px) 1fr;gap:var(--sp-16)}
.features-intro{position:sticky;top:110px;align-self:start}
.features-intro .btn{margin-top:var(--sp-6)}
.feature-list{list-style:none}
.feature-list li{
  display:flex;align-items:center;gap:var(--sp-4);padding:var(--sp-5) var(--sp-1);
  border-top:1px solid var(--line);
}
.feature-list li:last-child{border-bottom:1px solid var(--line)}
.f-num{font-size:var(--fs-xs);color:var(--ink-3);min-width:24px;font-weight:500}
.feature-list p{font-size:var(--fs-md);color:var(--ink)}
.feature-list .tile{width:38px;height:38px}

/* ---------- Testimonials ---------- */
.quotes{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-12)}
.quote{border-inline-start:3px solid var(--line-strong);padding-inline-start:var(--sp-5)}
.quote--offset{margin-top:var(--sp-16)}
.stars{display:flex;gap:3px;color:var(--tint-yellow-fg);margin-bottom:var(--sp-3)}
.stars .i{width:14px;height:14px}
.quote blockquote{font-size:var(--fs-lg);font-weight:500;line-height:1.9}
.quote figcaption{display:flex;align-items:center;gap:12px;margin-top:var(--sp-4)}
.avatar{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-weight:600;font-size:16px}
.avatar--blue{background:var(--tint-blue-bg);color:var(--tint-blue-fg)}
.avatar--pink{background:var(--tint-pink-bg);color:var(--tint-pink-fg)}
.quote figcaption strong{display:block;font-size:14px}
.quote figcaption span{font-size:var(--fs-sm);color:var(--ink-2)}

/* ---------- Verify strip ---------- */
.verify-form{display:flex;gap:var(--sp-3);max-width:520px}
.verify-form input{
  flex:1;height:42px;padding-inline:14px;border:1px solid var(--line);border-radius:var(--r-md);
  background:var(--bg);transition:border-color var(--fast),box-shadow var(--fast);
  font-size:14px;
}
.verify-form input::placeholder{color:var(--ink-3)}
.verify-form input:focus{outline:0;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
.verify-hint{font-size:var(--fs-sm);color:var(--ink-3);margin-top:var(--sp-3)}
.verify-hint code{font-family:var(--font);background:var(--bg-subtle);border:1px solid var(--line);border-radius:var(--r-sm);padding:1px 6px;font-size:12px}
.verify-card{
  display:flex;gap:var(--sp-4);align-items:flex-start;max-width:520px;margin-top:var(--sp-6);
  border:1px solid var(--line);border-radius:var(--r-lg);padding:var(--sp-5);
  animation:cardIn .4s var(--ease) both;
}
.verify-card strong{display:block;margin-bottom:var(--sp-2);color:var(--tint-green-fg)}
.verify-err{
  display:flex;align-items:center;gap:8px;margin-top:var(--sp-6);
  color:var(--danger);font-size:14px;animation:cardIn .4s var(--ease) both;
}

/* ---------- Callout ---------- */
.callout{
  display:flex;align-items:center;gap:var(--sp-5);
  background:var(--accent-soft);border:1px solid rgba(35,131,226,.16);border-radius:var(--r-lg);
  padding:var(--sp-6);
}
.callout__icon{width:48px;height:48px;border-radius:var(--r-md);background:var(--bg);border:1px solid var(--line);display:grid;place-items:center;color:var(--accent);flex:none}
.callout__body{flex:1}
.callout__body h3{font-size:18px;font-weight:600;margin-bottom:2px}
.callout__body p{font-size:14px;color:var(--ink-2)}
.callout .btn{flex:none}

/* ---------- FAQ (Notion toggle blocks) ---------- */
.faq{border-bottom:1px solid var(--line)}
.faq:first-child{border-top:1px solid var(--line)}
.faq__q{width:100%;display:flex;align-items:center;gap:12px;text-align:start;padding:18px 4px;font-size:15.5px;font-weight:500}
.faq__q:hover{color:var(--ink-2)}
.faq__q .chev{color:var(--ink-3);transform:rotate(90deg);transition:transform var(--base) var(--ease)}
.faq.open .chev{transform:rotate(0deg)}
.faq__a{display:grid;grid-template-rows:0fr;transition:grid-template-rows var(--slow) var(--ease)}
.faq__a-in{overflow:hidden}
.faq__a p{padding:0 28px var(--sp-5) 4px;color:var(--ink-2);font-size:14.5px;max-width:640px}
.faq.open .faq__a{grid-template-rows:1fr}

/* ---------- Footer ---------- */
.site-footer{background:var(--bg-subtle);border-top:1px solid var(--line);padding-block:var(--sp-16) var(--sp-6)}
.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:var(--sp-10)}
.footer-brand p{font-size:14px;color:var(--ink-2);max-width:300px;margin-block:var(--sp-4)}
.store-badges{display:flex;gap:var(--sp-3)}
.store-badge{
  display:flex;align-items:center;gap:10px;padding:8px 14px;
  border:1px solid var(--line-strong);border-radius:var(--r-md);background:var(--bg);
  transition:background var(--fast);
}
.store-badge:hover{background:var(--bg-hover)}
.store-badge small{display:block;font-size:10.5px;color:var(--ink-3)}
.store-badge strong{display:block;font-size:13.5px;line-height:1.2}
.footer-grid h4{font-size:var(--fs-sm);font-weight:600;color:var(--ink);margin-bottom:var(--sp-4)}
.footer-grid nav{display:grid;gap:2px;align-content:start}
.footer-grid nav a,.footer-grid nav button{
  text-align:start;font-size:14px;color:var(--ink-2);padding:4px 0;transition:color var(--fast);
}
.footer-grid nav a:hover,.footer-grid nav button:hover{color:var(--ink)}
.social-row{display:flex;gap:8px;flex-wrap:wrap}
.social-row .icon-btn{border:1px solid var(--line);background:var(--bg)}
.footer-pay{
  display:flex;justify-content:space-between;align-items:center;gap:var(--sp-4);flex-wrap:wrap;
  border-top:1px solid var(--line);margin-top:var(--sp-12);padding-top:var(--sp-5);
}
.pay-chips{display:flex;gap:8px;flex-wrap:wrap}
.pay-chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:var(--r-sm);background:var(--bg);padding:4px 10px;font-size:12px;font-weight:600;color:var(--ink-2)}
.ssl-note{display:inline-flex;align-items:center;gap:7px;font-size:var(--fs-sm);color:var(--ink-2)}
.footer-bottom{
  display:flex;justify-content:space-between;gap:var(--sp-4);flex-wrap:wrap;
  margin-top:var(--sp-5);padding-top:var(--sp-5);border-top:1px solid var(--line);
  font-size:var(--fs-sm);color:var(--ink-3);
}

/* ---------- Cart drawer ---------- */
.cart-items{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:2px}
.cart-row{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3);padding:12px 4px;border-bottom:1px solid var(--line)}
.cart-row strong{display:block;font-size:14px;font-weight:500}
.cart-row__price{font-size:var(--fs-sm);color:var(--ink-2)}
.cart-empty{margin:auto;text-align:center;display:grid;justify-items:center;gap:6px;color:var(--ink-3);padding:var(--sp-8) 0}
.cart-empty .i{color:var(--ink-3)}
.cart-empty p{font-size:15px;font-weight:600;color:var(--ink-2)}
.cart-empty span{font-size:var(--fs-sm);max-width:220px}
.cart-empty .btn{margin-top:var(--sp-3)}
.drawer__foot{border-top:1px solid var(--line);padding-top:var(--sp-4);margin-top:var(--sp-4)}
.cart-total{display:flex;justify-content:space-between;font-weight:600;font-size:15px;margin-bottom:var(--sp-4)}
.cart-count{
  position:absolute;top:2px;inset-inline-start:2px;min-width:16px;height:16px;
  border-radius:var(--r-full);background:var(--accent);color:#fff;
  font-size:10px;font-weight:600;display:grid;place-items:center;padding-inline:4px;
}
.cart-btn{position:relative}
.cart-count.pop{animation:pop .3s var(--ease)}
@keyframes pop{0%{transform:scale(.4)}60%{transform:scale(1.3)}100%{transform:scale(1)}}

/* ---------- Modal ---------- */
.modal-wrap{position:fixed;inset:0;z-index:70;display:none;place-items:center;padding:var(--sp-5);background:var(--scrim)}
.modal-wrap.show{display:grid}
.modal{
  position:relative;width:min(440px,100%);background:var(--bg);border-radius:var(--r-lg);
  box-shadow:var(--sh-pop);padding:var(--sp-6);animation:popIn .28s var(--ease);
}
@keyframes popIn{from{opacity:0;transform:scale(.96) translateY(8px)}to{opacity:1;transform:none}}
.modal__close{position:absolute;top:14px;inset-inline-start:14px}
.modal__title{font-size:18px;font-weight:700;margin-bottom:var(--sp-1)}
.modal__sub{font-size:14px;color:var(--ink-2);margin-bottom:var(--sp-5)}
.modal__form{display:grid;gap:var(--sp-4)}
.field{display:grid;gap:6px}
.field > span{font-size:13px;font-weight:500}
.field em{color:var(--danger);font-style:normal}
.field input,.field textarea{
  width:100%;padding:9px 12px;border:1px solid var(--line);border-radius:var(--r-md);
  background:var(--bg);transition:border-color var(--fast),box-shadow var(--fast);resize:vertical;
}
.field input::placeholder,.field textarea::placeholder{color:var(--ink-3)}
.field input:focus,.field textarea:focus{outline:0;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
.field input.invalid{border-color:var(--danger);box-shadow:0 0 0 3px rgba(212,76,71,.12)}
.field__err{color:var(--danger);font-size:12px}
.modal__success{text-align:center;padding:var(--sp-4) 0}
.modal__success .tile{margin:0 auto var(--sp-4)}
.modal__success h3{font-size:17px;margin-bottom:var(--sp-1)}
.modal__success p{font-size:14px;color:var(--ink-2)}

/* ---------- Command palette (Ctrl/⌘ + K) ---------- */
.palette-wrap{position:fixed;inset:0;z-index:72;display:none;justify-content:center;align-items:flex-start;padding:12vh var(--sp-4) var(--sp-4);background:var(--scrim)}
.palette-wrap.show{display:flex}
.palette{
  width:min(600px,100%);background:var(--bg);border-radius:var(--r-lg);overflow:hidden;
  box-shadow:var(--sh-pop);animation:popIn .22s var(--ease);
}
.palette__head{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line);color:var(--ink-3)}
.palette__head input{flex:1;border:0;outline:0;background:transparent;font-size:15px}
.palette__results{max-height:320px;overflow-y:auto;padding:8px}
.pal-group{font-size:var(--fs-xs);font-weight:500;color:var(--ink-3);padding:10px 10px 4px}
.pal-item{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:var(--r-md);font-size:14px;color:var(--ink-2);cursor:pointer}
.pal-item .i{width:16px;height:16px;color:var(--ink-3)}
.pal-item.sel{background:var(--bg-hover);color:var(--ink)}
.pal-sub{margin-inline-start:auto;font-size:12px;color:var(--ink-3)}
.pal-empty{padding:var(--sp-8) 0;text-align:center;color:var(--ink-3);font-size:14px}
.pal-foot{display:flex;gap:var(--sp-4);padding:9px 16px;border-top:1px solid var(--line);font-size:var(--fs-xs);color:var(--ink-3)}
.pal-foot span{display:inline-flex;align-items:center;gap:5px}

/* ---------- Toasts ---------- */
.toasts{position:fixed;bottom:24px;inset-inline:0;z-index:90;display:grid;justify-items:center;gap:8px;pointer-events:none}
.toast{
  display:flex;align-items:center;gap:10px;max-width:min(90vw,420px);
  background:var(--inverse-bg);color:var(--inverse-ink);
  padding:10px 16px;border-radius:var(--r-md);box-shadow:var(--sh-toast);font-size:14px;
  opacity:0;transform:translateY(12px);transition:opacity var(--base) var(--ease),transform var(--base) var(--ease);
}
.toast.show{opacity:1;transform:none}
.toast .i{width:16px;height:16px}

/* ---------- Reveal on scroll ---------- */
[data-reveal]{opacity:0;transform:translateY(14px);transition:opacity .55s var(--ease),transform .55s var(--ease);transition-delay:var(--d,0ms)}
[data-reveal].is-in{opacity:1;transform:none}
.flash{animation:flash 1.4s var(--ease)}
@keyframes flash{
  0%{box-shadow:0 0 0 0 rgba(35,131,226,0)}
  25%{box-shadow:0 0 0 4px rgba(35,131,226,.35);border-color:var(--accent)}
  100%{box-shadow:0 0 0 0 rgba(35,131,226,0)}
}

/* ---------- Responsive ---------- */
@media (max-width:1100px){
  .header-search span,.header-search kbd{display:none}
}
@media (max-width:960px){
  .features-grid{grid-template-columns:1fr;gap:var(--sp-8)}
  .features-intro{position:static}
}
@media (max-width:920px){
  .main-nav,.login-desktop{display:none}
  .menu-btn{display:grid}
  .footer-grid{grid-template-columns:1fr 1fr}
}
@media (max-width:820px){
  .quotes{grid-template-columns:1fr}
  .quote--offset{margin-top:0}
}
@media (max-width:760px){
  .b-card{flex-direction:column;align-items:stretch}
  .b-card__price{border-inline-start:0;border-top:1px solid var(--line);padding-inline-start:0;padding-top:var(--sp-5);min-width:0}
  .callout{flex-direction:column;align-items:flex-start}
}
@media (max-width:640px){
  .section{padding-block:var(--sp-16)}
  .container{width:min(100% - 40px,var(--container))}
  .hero{padding-block:var(--sp-12) var(--sp-10)}
  .hero-subscribe{display:none}
  .metric + .metric{border-inline-start:0;padding-inline-start:0}
  .verify-form{flex-direction:column}
  .footer-grid{grid-template-columns:1fr;gap:var(--sp-8)}
}

/* ---------- Reduced motion ---------- */
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
  [data-reveal]{opacity:1;transform:none}
}
</style>
</head>
<body>

